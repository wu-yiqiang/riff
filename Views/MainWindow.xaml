<Window
    x:Class="riff.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:riff"
    xmlns:localControls="clr-namespace:riff.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:p="clr-namespace:riff.Views"
    Title="Riff"
    Width="1100"
    Height="600"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="1" UseAeroCaptionButtons="True" />
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <FontFamily x:Key="FF">../Assets/Fonts/#iconfont</FontFamily>
        <Style x:Key="RoundedTextBox" TargetType="TextBox">
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="6,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="BorderBrush" Value="#E0E0E0" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Width" Value="180" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border
                            x:Name="border"
                            Background="White"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="15">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ScrollViewer
                                    x:Name="PART_ContentHost"
                                    Margin="{TemplateBinding Padding}"
                                    VerticalAlignment="Center" />
                                <TextBlock
                                    Grid.Column="1"
                                    Margin="0,0,10,0"
                                    VerticalAlignment="Center"
                                    Cursor="Hand"
                                    FontFamily="{StaticResource FF}"
                                    FontSize="16"
                                    Foreground="#999999"
                                    Text="&#xe771;" />
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Offset="0" Color="#F8FFFB" />
                <GradientStop Offset="1" Color="#FAFAFE" />
            </LinearGradientBrush>
        </Grid.Background>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="90" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel
                Grid.Row="0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <Border Width="50" Height="50">
                    <Border.Background>
                        <ImageBrush
                            ImageSource="../Assets/Images/Logo.png"
                            Opacity="0.5"
                            Stretch="UniformToFill" />
                    </Border.Background>
                </Border>
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="18"
                    FontWeight="Bold"
                    Foreground="Orange"
                    Text="Riff Music" />
            </StackPanel>
            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <localControls:MenuControl
                    x:Name="MenuHome"
                    Grid.Row="0"
                    Click="Menu_Click"
                    Icon="&#xe6ac;"
                    Label="首页" />
                <localControls:MenuControl
                    x:Name="MenuPlaylist"
                    Grid.Row="1"
                    Click="Menu_Click"
                    Icon="&#xe76f;"
                    Label="精品歌单" />
                <localControls:MenuControl
                    x:Name="MenuSinger"
                    Grid.Row="2"
                    Click="Menu_Click"
                    Icon="&#xe76e;"
                    Label="歌手推荐" />
                <localControls:MenuControl
                    x:Name="MenuRank"
                    Grid.Row="3"
                    Click="Menu_Click"
                    Icon="&#xe602;"
                    Label="单曲排行" />
                <localControls:SubmenuControl
                    x:Name="SubmenuRank"
                    Grid.Row="4"
                    Icon="&#xe76d;"
                    Label="我的音乐" />
            </Grid>
        </Grid>
        <Border
            Grid.Column="1"
            Width="1"
            Background="#19000000" />
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition />
            </Grid.RowDefinitions>
            <Border Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Padding="0,0,0,10">
                        <TextBox Style="{StaticResource RoundedTextBox}" />
                    </Border>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden">
                        <p:HomePage />
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
